# Suncare Backend — Local Environment Template (do not commit real secrets)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# SQL Server 2019+ TCP connection (schema is managed by database/*.sql; TCP/IP must be enabled on SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Suncare
DB_USERNAME=sa
DB_PASSWORD=ChangeMe_LocalOnly
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# SQL Server preflight and lock defaults (T03)
SUNCARE_DB_PREFLIGHT_ENABLED=true
SUNCARE_DB_ENFORCE_SET_OPTIONS=true

# Controlled initial SYSTEM_ADMIN + SystemSetting bootstrap (opt-in only; never hardcode passwords)
SUNCARE_BOOTSTRAP_ENABLED=false
SUNCARE_BOOTSTRAP_ADMIN_LOGIN=admin@suncare.local
SUNCARE_BOOTSTRAP_ADMIN_PASSWORD=
SUNCARE_BOOTSTRAP_ADMIN_STAFF_CODE=ADM-001
SUNCARE_BOOTSTRAP_ADMIN_FULL_NAME=Quan tri he thong

# Frontend dev server origin for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
